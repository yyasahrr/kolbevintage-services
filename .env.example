# ─────────────────────────────────────────────────────────────────────────────
# متغیرهای محیطی کلبه — نمونه برای توسعهٔ محلی
# این فایل را به `.env` کپی کنید و مقادیر را جایگزین کنید.
# هرگز `.env` واقعی را commit نکنید.
# برای استقرار تولیدی، `infra/.env.example` را ببینید.
# ─────────────────────────────────────────────────────────────────────────────

# دیتابیس محلی (embedded-postgres روی 55432)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/kolbe

# نشست — امضای توکن‌ها. حداقل ۳۲ کاراکتر تصادفی.
# تولید: openssl rand -base64 48
KOLBE_SESSION_SECRET=change-this-to-a-long-random-secret-at-least-32-chars

# مبدأهای مجاز CORS (با کاما). در تولید اجباری است.
KOLBE_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# Redis (اختیاری در توسعه — اگر تنظیم نشود، کش/صف غیرفعال می‌ماند)
REDIS_URL=redis://127.0.0.1:6379

# ذخیره‌سازی شیئی — ParsPack Object Storage (سازگار با S3)
# در توسعه می‌تواند MinIO محلی باشد: http://localhost:9000
S3_ENDPOINT=https://s3.parspack.com
S3_REGION=default
S3_BUCKET=kolbe-media
S3_ACCESS_KEY=
S3_SECRET_KEY=

# پرو مجازی لباس (Perfect Corp) — فقط سمت سرور، هرگز با پیشوند NEXT_PUBLIC_
PERFECT_CORP_API_KEY=

# دادهٔ نمایشی (حساب‌های دمو admin@kolbe.ir / vip@boutique.ir / nilgoon@kolbe.ir)
# پیش‌فرض خاموش است. در توسعه true بگذارید تا کاتالوگ و حساب‌های آزمون کاشته شود.
KOLBE_SEED_DEMO_DATA=true

# فروشگاه
NEXT_PUBLIC_API_BASE=/api/v1

# آدرس داخلی سرویس Nest برای پروکسی `/api/v1` در توسعه (rewrite در next.config).
# بدون آن، نشستِ قانونیِ فروشگاه (useStorefrontSession) به بک‌اند نمی‌رسد.
KOLBE_API_INTERNAL_URL=http://127.0.0.1:4000
