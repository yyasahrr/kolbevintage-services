# دیتابیس مدوسا (در فاز ۱ میتوانید dump همین Postgres را بگیرید)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kolbe_medusa

# برای dev اجباری نیست؛ در پروداکشن برای worker و event-bus لازم است
REDIS_URL=

# رمز امضای توکنها (حداقل ۳۲ کاراکتر تصادفی)
JWT_SECRET=supersecret-change-me

# مبدأهای مجاز CORS
ADMIN_CORS=http://localhost:7001,http://localhost:5173
AUTH_CORS=http://localhost:7001,http://localhost:5173
STORE_CORS=http://localhost:5173,http://localhost:5174

# فروشگاه و پنل ادمین
MEDUSA_BACKEND_URL=http://localhost:9000

# کلید publishable برای Store API (از /app/settings/api-keys بسازید)
# KOLBE_PUBLISHABLE_KEY=pk_...
# راز یکبارهای ساخت ادمین اول (بعد از استفاده حذف کنید)
# KOLBE_BOOTSTRAP_SECRET=change-me
