# ─────────────────────────────────────────────────────────────────────────────
# متغیرهای محیطی زیرساخت کلبه (نمونه)
# این فایل را به `.env` کنار docker-compose کپی و مقادیر را جایگزین کنید.
# هرگز `.env` واقعی را commit نکنید.
# ─────────────────────────────────────────────────────────────────────────────

# دیتابیس
POSTGRES_USER=kolbe
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=kolbe
DATABASE_URL=postgres://kolbe:change-this-strong-password@postgres:5432/kolbe

# نشست — امضای توکن‌ها. حداقل ۳۲ کاراکتر تصادفی.
# تولید: openssl rand -base64 48
KOLBE_SESSION_SECRET=change-this-to-a-long-random-secret-at-least-32-chars

# مبدأهای مجاز CORS (با کاما). در تولید اجباری است.
KOLBE_ALLOWED_ORIGINS=https://kolbe.ir,https://www.kolbe.ir

# Redis (کش، صف BullMQ، لیست سیاه نشست)
REDIS_URL=redis://redis:6379

# ذخیره‌سازی شیئی — ParsPack Object Storage (سازگار با S3)
S3_ENDPOINT=https://s3.parspack.com
S3_REGION=default
S3_BUCKET=kolbe-media
S3_ACCESS_KEY=
S3_SECRET_KEY=

# پرو مجازی لباس (Perfect Corp) — فقط سمت سرور، هرگز با پیشوند NEXT_PUBLIC_
PERFECT_CORP_API_KEY=

# دادهٔ نمایشی (حساب‌های دمو admin@kolbe.ir / vip@boutique.ir / nilgoon@kolbe.ir
# و کاتالوگ نمونه). پیش‌فرض خاموش است.
#
# ⚠️ در تولید این مقدار را **تنظیم نکنید**؛ حتی با مقدار true هم اجرا نخواهد شد،
# چون کاشت فقط وقتی انجام می‌شود که NODE_ENV غیر از production باشد. حساب مدیر
# واقعی را با ابزار اپراتور بسازید:
#   KOLBE_ADMIN_EMAIL=... KOLBE_ADMIN_PASSWORD=... node scripts/create-admin.mjs
#
# در محیط توسعه، برای داشتن کاتالوگ و حساب‌های آزمون، true بگذارید.
KOLBE_SEED_DEMO_DATA=false

# فروشگاه
NEXT_PUBLIC_API_BASE=/api/v1
